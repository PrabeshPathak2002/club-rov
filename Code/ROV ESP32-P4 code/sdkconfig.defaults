CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_FREERTOS_HZ=100
# Hardware revision is deliberately not overridden. Keep the local sdkconfig
# until the attached chip revision has been read; never force a revision mismatch.

# IMX219 H264 video (board flash capacity verified: 32 MB)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_IMX219=y
CONFIG_CAMERA_IMX219_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_IMX219_MIPI_IF_FORMAT_INDEX_DEFAULT=2
# CONFIG_CAMERA_IMX708 is not set
# CONFIG_CAM_MOTOR_DW9807 is not set
# CONFIG_ESP_IPA_AF_ALGORITHM is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# CONFIG_SPIRAM_SPEED_20M is not set
# CONFIG_SPIRAM_SPEED_80M is not set
# CONFIG_CACHE_L2_CACHE_128KB is not set
# CONFIG_CACHE_L2_CACHE_LINE_64B is not set

CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bench board: ESP32-P4 revision 1.3 (pre-v3). Review for replacement boards.
CONFIG_ESP32P4_REV_MIN_1=y
