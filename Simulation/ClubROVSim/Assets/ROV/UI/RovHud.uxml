<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="RovHud.uss" />
    <ui:VisualElement name="root" class="hud" picking-mode="Ignore">
        <ui:VisualElement class="header" picking-mode="Ignore">
            <ui:VisualElement class="identity" picking-mode="Ignore">
                <ui:Label text="CLUB ROV / POOL LAB" class="title" />
                <ui:Label name="arming" text="LOCAL CONTROL" class="arming" />
                <ui:Label text="Pilot training · six independent thrusters" class="subtitle" />
                <ui:Label name="camera-mode" text="CHASE · native display" class="subtitle" />
                <ui:Button name="camera-toggle" text="CAMERA · SWITCH TO FPV" focusable="false" />
                <ui:Label name="sitl-status" text="LOCAL · Unity pilot" class="subtitle" />
                <ui:TextField name="sitl-address" label="SITL IPv4" value="127.0.0.1" />
                <ui:Button name="sitl-toggle" text="CONNECT SITL · SIMULATION ONLY" focusable="false" />
                <ui:Foldout text="TRAINING CONDITIONS &amp; SCENARIOS" value="false" class="training-foldout">
                    <ui:ScrollView class="settings-scroll">
                        <ui:DropdownField name="training-map" label="Training map" />
                        <ui:Button name="map-apply" text="LOAD MAP &amp; RESET START" focusable="false" />
                        <ui:Label name="map-description" class="note wrap" />
                        <ui:DropdownField name="scenario" label="Conditions preset" />
                        <ui:Button name="scenario-apply" text="APPLY PRESET &amp; RESET START" focusable="false" />
                        <ui:Slider name="current-east" label="Current east (m/s)" low-value="-1" high-value="1" show-input-field="true" focusable="false" />
                        <ui:Slider name="current-north" label="Current north (m/s)" low-value="-1" high-value="1" show-input-field="true" focusable="false" />
                        <ui:Slider name="buoyancy" label="Buoyancy bias (%)" low-value="-10" high-value="10" show-input-field="true" focusable="false" />
                        <ui:DropdownField name="failed-thruster" label="Affected thruster" />
                        <ui:Slider name="thruster-health" label="Remaining thrust (%)" low-value="0" high-value="100" show-input-field="true" focusable="false" />
                        <ui:Slider name="delay" label="FPV delay (ms)" low-value="0" high-value="500" show-input-field="true" focusable="false" />
                        <ui:Slider name="particles" label="Suspended particles" low-value="0" high-value="1" focusable="false" />
                        <ui:Slider name="light" label="Camera light" low-value="0" high-value="1" focusable="false" />
                        <ui:TextField name="scenario-name" label="Save as" value="My practice" max-length="40" />
                        <ui:Button name="scenario-save" text="SAVE / REPLACE · CURRENT POSE AS START" focusable="false" />
                        <ui:Label name="scenario-notice" class="course-stat" />
                        <ui:Label text="Conditions changed during a run make it practice only. Preset loading requires SITL disconnected." class="note wrap" />
                    </ui:ScrollView>
                </ui:Foldout>
            </ui:VisualElement>
            <ui:VisualElement class="course-panel">
                <ui:Label text="POOL COURSE · SIMULATION ONLY" class="badge" />
                <ui:Label name="objective" text="Gate 1/3 — cross toward the far end" class="objective" />
                <ui:Label name="run" text="TIME 00:00.0    COLLISIONS 0    HOLD 0.0/3 s" class="course-stat" />
                <ui:Label name="score" text="SCORE 1000 · BEST —" class="course-stat" />
                <ui:Label name="run-save" class="course-stat" />
                <ui:Label name="target" text="Follow the numbered yellow gates" class="course-stat" />
                <ui:Label text="Select a training map in Training Conditions &amp; Scenarios" class="course-stat" />
                <ui:Label name="visibility-text" text="VISIBILITY 8.0 m · visual approximation" class="course-stat" />
                <ui:Slider name="visibility" low-value="1" high-value="20" value="8" picking-mode="Position" focusable="false" />
                <ui:Button name="restart" text="RESTART COURSE · HOME / START" picking-mode="Position" focusable="false" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="footer" picking-mode="Ignore">
            <ui:VisualElement class="graphics-row" picking-mode="Position">
                <ui:Label name="performance" text="Measuring FPS..." class="course-stat" />
                <ui:DropdownField name="graphics-quality" label="Graphics" />
                <ui:DropdownField name="graphics-cap" label="FPS limit" />
            </ui:VisualElement>
                <ui:Label name="telemetry" text="DEPTH  1.20 m     SPEED  0.00 m/s     HEADING  000°" class="telemetry" />
            <ui:Label name="thrusters" text="H1 0.00   H2 0.00   H3 0.00   H4 0.00   V1 0.00   V2 0.00" class="outputs" />
            <ui:Label text="WASD move    R/F up/down    Q/E turn    V camera    H hide HUD    HOME reset    SPACE cut thrust" class="controls" />
            <ui:Label text="Gamepad: left stick move · right stick turn/depth · Start reset · Back camera · right-stick click HUD · A cut thrust" class="controls" />
            <ui:Label text="Provisional mass, buoyancy, drag and thrust. No connection to the physical ROV." class="note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
